# Tarima — environment variables.
# Copy this file to `.env.local` and fill in the values. None are required
# for the app to run; missing vars fall back to bundled defaults.
#
# Anything starting with NEXT_PUBLIC_ is shipped to the browser. Don't put
# secrets here — server-side billing webhooks belong in a separate route
# with non-public env vars (Stripe secret key, RevenueCat webhook secret).

# ─── Beat library ───────────────────────────────────────────────────────
# Google Sheet "Publish to web → CSV" URL. The sheet drives the beat
# catalogue (id, name, artist, bpm, style, mp3_url, license, source_url,
# bar1_offset_sec, feel, active, pro). MP3s themselves should live in
# Cloudflare R2 with public read; the sheet stores the absolute URLs.
# Without this, the app uses the 13 bundled beats only.
NEXT_PUBLIC_BEATS_SHEET_URL=

# ─── Pro checkout (web fallback) ────────────────────────────────────────
# Stripe Payment Links for the web upgrade flow. Mobile builds go through
# the Play Store / App Store via RevenueCat instead, so these are only
# used until the mobile build ships.
# Create at: https://dashboard.stripe.com/payment-links
NEXT_PUBLIC_STRIPE_YEARLY_URL=
NEXT_PUBLIC_STRIPE_MONTHLY_URL=

# ─── Pro checkout (native / Play Billing via RevenueCat) ────────────────
# RevenueCat *public* Android SDK key (starts with "goog_"). Native builds
# use this to fetch offerings and run Google Play purchases. Without it,
# native falls back to the same coming-soon path as web (no crash).
# Find it in RevenueCat → Project → API keys → Android app key.
# Entitlement id expected: "pro". Suggested product ids:
#   tarima_pro_monthly, tarima_pro_yearly  (mapped to $rc_monthly/$rc_annual)
NEXT_PUBLIC_RC_ANDROID_KEY=

# RevenueCat *public* iOS SDK key (starts with "appl_"). Same role as the
# Android key, for the App Store / StoreKit build. Separate RevenueCat app,
# same "pro" entitlement and same product ids. Without it the iOS native
# build falls back to the coming-soon path (no crash). See
# store/app-store-submission.md.
NEXT_PUBLIC_RC_IOS_KEY=

# ─── Redeem codes (UGC "manda un video, te damos Pro" promo) ─────────────
# Google Apps Script web-app URL backing the private "codes" Sheet.
# See store/redeem-backend.gs for setup. Without it the redeem input is
# hidden. Baked at build time (static export), so rebuild after setting it.
NEXT_PUBLIC_REDEEM_URL=

# ─── Dev / QA toggles ───────────────────────────────────────────────────
# Set to "1" to show the manual "Activar Pro localmente" button on /pro.
# Useful for QA-ing gated flows without paying. NEVER set this in prod.
NEXT_PUBLIC_PRO_DEV_TOGGLE=
